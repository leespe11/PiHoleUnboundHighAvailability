#!/bin/bash
echo "[INFO] Loading environmental variables"
set -a
source config.env

IFS=', ' read -r -a hosts <<< "$HOSTS"
IFS=', ' read -r -a hostnames <<< "$HOSTNAMES"
IFS=', ' read -r -a ssh_usernames <<< "$SSH_USERNAMES"

if [ ${#hosts[@]} -ne ${#hostnames[@]} ] || [ ${#hosts[@]} -ne ${#ssh_usernames[@]} ]; then
    if [ ${#hosts[@]} -gt 1 ] || [ ${#hostnames[@]} -gt 1 ]; then
		echo "[ERR] ARRAY LENGTHS DONT MATCH"
		echo "[ERR] HOSTS, HOSTNAMES, and SSH_USERNAMES environment variables do not match"
		exit 0
	fi
fi

if [ "$1" == "" ] || [ $# -gt 1 ] && [ ${#hosts[@]} -ne 1 ]; then
	echo "*** Please make sure you have configured the environment variables in config.env ***"
	echo "---USAGE---"
	echo "./run [server index]|[hostname]"
	exit 0
fi

index=-1
STANDALONE=0
if [ ${#hosts[@]} -eq 1 ]; then
	STANDALONE=1
	index=0
elif [[ $1 =~ ^[0-9]+$ ]]; then
	if [ "$1" -lt "${#hosts[@]}" ]; then
		index=$1
	fi
else
	for i in "${!hosts[@]}"; do
		if [ "${hostnames[$i]}" == "$1" ] || [ "${hosts[$i]}" == "$1" ]; then
			index=$i
			break
		fi
	done
fi

if [ $index -lt 0 ]; then
	echo "[ERR] Hostname / Host index not found: ${1}"
	echo "[ERR] Valid options: 0-$(( ${#hosts[@]} - 1 )), ${HOSTNAMES}, or ${HOSTS}"
	exit 1
fi

type=""
if [ $index -eq 0 ]; then
	type="MASTER"
else
	type="BACKUP"
fi

index_plus=$((index + 1))
if [ $index -eq $((${#hosts[@]} - 1)) ]; then
  export SSH_IP="${hosts[0]}"
  export SSH_USER="${ssh_usernames[0]}"
else
  export SSH_IP="${hosts[$index_plus]}"
  export SSH_USER="${ssh_usernames[$index_plus]}"
fi
export LOCAL_IP="${hosts[$index]}"
export LOCAL_USER="${hostnames[$index]}"

################

echo "[INFO] Checking if ./data directory exist"
if [ -d "./data" ];then
	echo "[INFO] Directory ./data exists!"
else 
	echo "[WARN] Directory ./data not found"
	echo "[INFO] Creating: ./data"
	mkdir ./data
fi

if [ $STANDALONE -eq 0 ] && [ $index -eq 0 ]; then
	COMPOSE_PROFILES=master
fi

echo "[INFO] Starting Docker Environment"
docker compose up -d --build #--force-recreate
echo "[INFO] Done starting containers"

if [ $STANDALONE -eq 0 ]; then
  apt update && apt install keepalived -y

  systemctl enable keepalived.service

  # Resolve the real path to bash. On merged-/usr systems (Ubuntu, Debian 12+)
  # /bin is a symlink to usr/bin, and keepalived's enable_script_security
  # rejects script paths that go through a symlinked directory.
  BASH_BIN=$(readlink -f "$(command -v bash)")
  echo "[INFO] Using bash at $BASH_BIN for keepalived checks"

  # keepalived only runs scripts that are owned by root and not writable
  # by anyone else, including every directory above them
  echo "[INFO] Installing /etc/scripts/chk_ftl.sh"
  install -d -o root -g root -m 755 /etc/scripts
  install -o root -g root -m 755 ./config/chk_ftl.sh /etc/scripts/chk_ftl.sh
  # Strip Windows line endings in case the file was edited on Windows
  sed -i 's/\r$//' /etc/scripts/chk_ftl.sh

  # Checks subtract priority when they FAIL, so a healthy node never gains
  # points. The gap between nodes (5) is smaller than any single penalty (10),
  # so one failed check on the master hands the VIP to the backup, and the
  # master takes it back once it is healthy again.
  #   index 0 (MASTER) = 150, index 1 = 145, index 2 = 140, ...
  PRIORITY=$((150 - (index * 5)))

  IFACE=$(ip -o -4 addr show | awk -v ip="$LOCAL_IP" '$4 ~ "^"ip"/" {print $2; exit}')
  # Fall back to the default-route interface if LOCAL_IP isn't found
  [ -z "$IFACE" ] && IFACE=$(ip route show default | awk '{print $5; exit}')

  echo "[INFO] Writing /etc/keepalived/keepalived.conf ($type, priority $PRIORITY, interface $IFACE)"
  cat > /etc/keepalived/keepalived.conf <<EOF
global_defs {
	router_id pihole-dns-0$index_plus
	script_user root
	enable_script_security
}

vrrp_script chk_http_port {
	script "$BASH_BIN -c '</dev/tcp/127.0.0.1/80'"
	interval 2
	fall 2
	rise 2
	weight -10
}
vrrp_script chk_dns_port {
	script "$BASH_BIN -c '</dev/tcp/127.0.0.1/53'"
	interval 2
	fall 2
	rise 2
	weight -10
}
vrrp_script chk_docker_ftl {
	script "$BASH_BIN /etc/scripts/chk_ftl.sh"
	interval 7
	fall 2
	rise 1
	weight -20
}

vrrp_instance PIHOLE {
	state $type
	interface $IFACE
	virtual_router_id 55
	priority $PRIORITY
	advert_int 1
	unicast_src_ip $LOCAL_IP
	unicast_peer {
		$SSH_IP
	}

	authentication {
		auth_type PASS
		auth_pass $KEEPALIVE_PASSWD
	}

	virtual_ipaddress {
		$VIRTUAL_IP/24
	}

	track_script {
		chk_http_port
		chk_dns_port
		chk_docker_ftl
	}
}
EOF
  chmod 640 /etc/keepalived/keepalived.conf

  # Validate the config when this keepalived version supports it (2.x)
  if keepalived --help 2>&1 | grep -q -- '--config-test'; then
    if ! keepalived --config-test -f /etc/keepalived/keepalived.conf; then
      echo "[ERR] keepalived.conf failed validation, not restarting keepalived"
      exit 1
    fi
  fi

  systemctl restart keepalived.service

  #docker exec -it pihole ssh-keygen -t rsa
  #docker exec -it pihole ssh-copy-id $SSH_USER@$SSH_IP
fi

echo "[INFO] DONE SETUP"

exit 1
